{
  "name": "@react-native-ohos/openinstall-react-native",
  "displayName": "xxx",
  "version": "2.0.0",
  "description": "openinstall sdk plugin for react-native",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "license": "ISC",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git@github.com:OpenInstall/openinstall-react-native.git"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/OpenInstall/openinstall-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "ohos",
    "openharmony",
    "rnoh",
    "harmony/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "test": "jest --config jest/jest.config.js",
    "test:coverage": "jest --config jest/jest.config.js --coverage",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/openinstall_react_native/src/main/cpp/generated --ets-output-path ./harmony/openinstall_react_native/src/main/ets/generated"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "openinstall-react-native",
    "autolinking": {
      "cmakeLibraryTargetName": "openinstall_react_native",
      "ohPackageName": "@react-native-ohos/openinstall-react-native",
      "etsPackageClassName": "OpeninstallReactNativePackage",
      "cppPackageClassName": "OpeninstallReactNativePackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
